{
    "manifest_version": 3,
    "name": "知识星球网页全屏插件 - 稳定版",
    "version": "1.3",
    "description": "为知识星球网站提供稳定的网页全屏体验，不影响原有视频播放",
    "content_scripts": [
        {
            "matches": [
                "https://wx.zsxq.com/*",
                "https://*.zsxq.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "all_frames": true,
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*"
            ],
            "matches": [
                "https://*.zsxq.com/*"
            ]
        }
    ]
}